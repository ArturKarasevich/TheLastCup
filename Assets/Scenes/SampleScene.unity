  _creditsTextData: "<b>THE LAST CUP</b>\n\n\u041D\u0422\u041E \u0420\u041A\u0418 2026\u20132027\n\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \xAB\u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u0424\u043B\u043E\u0442\xBB\n\n<b>\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438:</b>\n\u0410\u043A\u0443\u043B\u043E\u0432 \u0410\u043B\u0435\u043A\u0441\u0435\u0439 \u2014 \u0413\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\n\u0413\u0430\u0431\u0431\u0430\u0441\u043E\u0432 \u0410\u0440\u0442\u0443\u0440 \u2014 \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\n\u0410\u043D\u0434\u0440\u0435\u0439 \u0410\u043D\u0434\u0440\u043E\u043D\u043E\u0432 \u2014 \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A\n\u042F\u0440\u043E\u0441\u043B\u0430\u0432 \u2014 \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0440\u0435\u0439\u0441.\n\u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435."
