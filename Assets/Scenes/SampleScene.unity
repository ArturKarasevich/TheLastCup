  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=118%><b>1. \u0418\u0432\u0430\u043D-\u0447\u0430\u0439</b></size>\r\n<color=#5C3A21><size=88%><i>\u041F\u043E\u043B\u043A\u0430 1: \u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 (\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u043F\u043E\u0440\u0430)</i></size></color>\r\n\r\n<b>\u0421\u0443\u0442\u044C:</b> \u0413\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u0436\u0430\u0440 \u0438 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u0435.\r\n<b>\u0412\u0438\u0434:</b> \u0422\u0451\u043C\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435 \u0441\u043A\u0440\u0443\u0447\u0435\u043D\u043D\u044B\u0435 \u0447\u0430\u0439\u043D\u044B\u0435 \u043B\u0438\u0441\u0442\u044C\u044F\r\n<b>\u0424\u0438\u0437\u0438\u043A\u0430:</b> \u0414\u0430\u0451\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0436\u0430\u0440 \u0432 \u0441\u0443\u0441\u0442\u0430\u0432\u044B \u0438 \u0445\u0440\u0435\u0431\u0435\u0442, \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043E\u0446\u0435\u043F\u0435\u043D\u0435\u043D\u0438\u0435 \u043E\u0442 \u0441\u044B\u0440\u043E\u0441\u0442\u0438.\r\n<b>\u042D\u043C\u043E\u0446\u0438\u0438:</b> \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u0442\u0432\u0451\u0440\u0434\u043E\u0439 \u0437\u0435\u043C\u043B\u0438 \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438, \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u0438 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435.\r\n<b>\u0412\u043A\u0443\u0441:</b> \u041F\u043B\u043E\u0442\u043D\u044B\u0439, \u0442\u0435\u0440\u043F\u043A\u0438\u0439, \u0434\u0440\u0435\u0432\u0435\u0441\u043D\u043E-\u043C\u0435\u0434\u043E\u0432\u044B\u0439.\r\n"
  m_isRightToLeft: 0
