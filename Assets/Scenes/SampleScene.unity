    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=118%><b>2. \u041B\u0438\u043F\u0430</b></size>\r\n<color=#5C3A21><size=88%><i>\u041F\u043E\u043B\u043A\u0430 1: \u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 (\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u043F\u043E\u0440\u0430)</i></size></color>\r\n\r\n<b>\u0421\u0443\u0442\u044C:</b> \u041C\u044F\u0433\u043A\u043E\u0435 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0435 \u0442\u0435\u043F\u043B\u043E \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\r\n<b>\u0412\u0438\u0434:</b> \u041F\u0443\u0448\u0438\u0441\u0442\u044B\u0435 \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0435 \u0446\u0432\u0435\u0442\u043A\u0438 \u0441 \u043F\u0440\u0438\u0446\u0432\u0435\u0442\u043D\u0438\u043A\u0430\u043C\u0438\r\n<b>\u0424\u0438\u0437\u0438\u043A\u0430:</b> \u0414\u0430\u0440\u0438\u0442 \u043C\u044F\u0433\u043A\u0438\u0439 \u043E\u0431\u0432\u043E\u043B\u0430\u043A\u0438\u0432\u0430\u044E\u0449\u0438\u0439 \u0436\u0430\u0440 \u0432 \u043F\u043B\u0435\u0447\u0430\u0445, \u043F\u0440\u043E\u0433\u0440\u0435\u0432\u0430\u0435\u0442 \u0437\u0430\u043C\u0451\u0440\u0437\u0448\u0435\u0435 \u0442\u0435\u043B\u043E.\r\n<b>\u042D\u043C\u043E\u0446\u0438\u0438:</b> \u0421\u0442\u0438\u0440\u0430\u0435\u0442 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u0445\u043E\u043B\u043E\u0434\u0430 \u0438 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0430, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043F\u0430\u043C\u044F\u0442\u044C \u043E \u0442\u0435\u043F\u043B\u0435 \u0434\u043E\u043C\u0430.\r\n<b>\u0412\u043A\u0443\u0441:</b> \u0421\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u044B\u0439, \u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0439, \u043C\u0435\u0434\u043E\u0432\u044B\u0439.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6ff97615a3794c44987216e0deea91b2, type: 2}
